# Slack User OAuth Token (xoxp-...) for reading DMs & mentions
SLACK_USER_TOKEN=xoxp-your-user-token-here

# Slack Bot User OAuth Token (xoxb-...) for posting approval cards & replies
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Slack App-Level Token (xapp-...) if using Socket Mode
SLACK_APP_TOKEN=xapp-your-app-token-here

# Your Slack User ID where private approval cards are sent
SLACK_USER_ID=U0123456789

# Google Gemini API Key
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Health check port for Render / Cloud Run
PORT=10000
